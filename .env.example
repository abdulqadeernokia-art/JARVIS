# Copy to .env. Never commit .env.
# Claude: no key needed. JARVIS uses your Claude.ai subscription via the Claude Code login.

JARVIS_USER_NAME=sir
# JARVIS_VOICE=en-GB-RyanNeural
# JARVIS_WAKE_SENSITIVITY=0.5

# Speech-to-text: Wispr Flow API (better with names, removes filler words). Without a key: Google free recognizer.
# Wispr's API is partner-only at the moment; request access at https://api-docs.wisprflow.ai
# WISPR_FLOW_API_KEY=

# Optional second opinion model for consult_model (also: pip install openai)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Development: run without real services
# JARVIS_MOCK_LLM=1
# JARVIS_MOCK_EMAIL=1
# JARVIS_MOCK_CALENDAR=1
# JARVIS_MOCK_COMPUTER=1
# JARVIS_DATA_DIR=data

# ---- Conversation mode ("Jarvis, let's talk" / python -m jarvis_os --converse) ----
# Brain: claude (Agent SDK, your Claude.ai login) | claude_api (fastest, needs a key) | ollama (local)
# CONV_BRAIN=claude
# CONV_CLAUDE_MODEL=claude-haiku-5-5
# JARVIS_CLAUDE_API_KEY=
# CONV_OLLAMA_MODEL=qwen3.5:2b
# CONV_MAX_TURNS=12
# Speech to text: whisper (local) | google.  tiny.en is ~0.4 s faster than base.en on this CPU, a bit less accurate
# CONV_STT=whisper
# CONV_WHISPER_MODEL=base.en
# CONV_WHISPER_DEVICE=auto
# Text to speech: auto (piper if downloaded, else edge) | piper | edge | elevenlabs
# CONV_TTS=auto
# CONV_PIPER_MODEL=data/models/piper/en_GB-alan-medium.onnx
# CONV_VOICE=en-GB-RyanNeural
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# Turn taking
# CONV_END_SILENCE_MS=700
# CONV_VAD_THRESHOLD=0.5
# CONV_VAD_THRESHOLD_SPEAKING=0.85
# CONV_BARGE_IN_MS=260
# CONV_SPECULATIVE_STT_MS=250
# CONV_SILENCE_TIMEOUT=30
